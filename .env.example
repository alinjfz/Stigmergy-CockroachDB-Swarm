# CockroachDB Cloud SQL url (required for the live memory layer)
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# OpenRouter — free chat model for scent copy / tie-break (optional; heuristic fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# In-process store for UI tests only. Production/demo must use Cockroach.
# STIGMERGY_STORE=memory

# Tick rate
PICKER_TICK_MS=650
